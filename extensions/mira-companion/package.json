{
  "name": "mira-companion",
  "displayName": "Mira Companion",
  "description": "Codexとagentctl jobの作業が小さなドット絵世界の出来事になる、bottom-panelのMira World。",
  "version": "0.4.0",
  "publisher": "asakura",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "pet",
    "companion",
    "multi-agent"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:miraCompanion.world",
    "onCommand:miraCompanion.openWorld"
  ],
  "contributes": {
    "commands": [
      {
        "command": "miraCompanion.openWorld",
        "title": "ミラ: Mira Worldを開く",
        "icon": "$(mira-idle-1)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "miraCompanion.worldContainer",
          "title": "Mira World",
          "icon": "./media/mira-panel.svg"
        }
      ]
    },
    "views": {
      "miraCompanion.worldContainer": [
        {
          "type": "webview",
          "id": "miraCompanion.world",
          "name": "ミラの工房",
          "contextualTitle": "Mira World",
          "visibility": "visible"
        }
      ]
    },
    "icons": {
      "mira-idle-1": {
        "description": "Mira idle frame 1",
        "default": {
          "fontPath": "./media/mira-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "mira-idle-2": {
        "description": "Mira idle frame 2",
        "default": {
          "fontPath": "./media/mira-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "mira-idle-3": {
        "description": "Mira idle frame 3",
