          "fontCharacter": "\\E01D"
        }
      }
    },
    "configuration": {
      "title": "Mira Companion",
      "properties": {
        "miraCompanion.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Mira Worldを開く小さなstatus bar toggleを表示します。"
        },
        "miraCompanion.motion": {
          "type": "string",
          "enum": [
            "auto",
            "subtle",
            "full",
            "off"
          ],
          "default": "auto",
          "description": "Mira World内の移動とanimationの強さ。autoはworkbench.reduceMotionを尊重します。"
        },
        "miraCompanion.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "workspace初回とremote runtime rebuild直後だけbottom panelを開きます。同じruntimeでの以後はVS Codeのpanel状態を尊重します。"
        },
        "miraCompanion.stateFile": {
          "type": "string",
          "default": "",
          "description": "状態JSONへの絶対path。空欄ではMIRA_COMPANION_STATE_DIRまたはXDG state directoryを使います。"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
