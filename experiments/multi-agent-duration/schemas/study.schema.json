{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcontainer.local/schemas/agent-duration-study-v1.schema.json",
  "title": "Agent Duration Study v1",
  "description": "Finite, explicitly started study manifest for empirical agent duration measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "revision",
    "created_at",
    "execution_mode",
    "planning_resolution_ms",
    "relative_precision_target",
    "coverage_target",
    "limits",
    "reporting"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "execution_mode": {
      "const": "explicit-finite-batch"
    },
    "planning_resolution_ms": {
      "description": "Statistical/display resolution target, not an agent stop rule.",
      "type": "integer",
      "minimum": 1
    },
    "relative_precision_target": {
      "description": "Study-specific precision target, not a universal repetition count.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "coverage_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ids", "observation_block_classes"],
      "properties": {
        "profile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "observation_block_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["same-case", "between-case", "time-window", "paired-configuration"]
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_batch_ms", "hard_sample_cap", "max_concurrency", "role"],
      "properties": {
        "wall_clock_batch_ms": {
          "type": "integer",
          "minimum": 1
        },
        "hard_sample_cap": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "const": "runaway-safety-cap"
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typical_population", "typical_quantile_low", "typical_quantile_high"],
      "properties": {
        "typical_population": {
          "const": "quality-pass-user-result"
        },
        "typical_quantile_low": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "typical_quantile_high": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
