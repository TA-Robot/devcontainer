{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcontainer.local/schemas/agent-duration-fixture-v1.schema.json",
  "title": "Agent Duration Disposable Fixture v1",
  "description": "Content-free snapshot and isolation manifest for one generated case workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "created_at",
    "case",
    "snapshot",
    "execution_contract",
    "paths",
    "workspace_files",
    "initial_oracle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixture_id": {
      "$ref": "#/$defs/id"
    },
    "created_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "revision", "catalog_id", "catalog_revision", "catalog_digest", "capsule_digest", "recipe_id", "recipe_revision"],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "catalog_id": {
          "$ref": "#/$defs/id"
        },
        "catalog_revision": {
          "type": "integer",
          "minimum": 1
        },
        "catalog_digest": {
          "$ref": "#/$defs/sha256"
        },
        "capsule_digest": {
          "$ref": "#/$defs/sha256"
        },
        "recipe_id": {
          "$ref": "#/$defs/id"
        },
        "recipe_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "bundle_digest", "workspace_tree_digest", "instruction_set_digest"],
      "properties": {
        "base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "bundle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "workspace_tree_digest": {
          "$ref": "#/$defs/sha256"
        },
        "instruction_set_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "task_network_policy",
        "isolation_required",
        "evaluator_isolation_required",
        "gold_visibility",
        "workspace_validation_commands",
        "online_evaluator_id"
      ],
      "properties": {
        "lane": {
          "const": "isolated"
        },
        "task_network_policy": {
          "const": "disabled"
        },
        "isolation_required": {
          "const": "workspace-only-container-mount"
        },
        "evaluator_isolation_required": {
          "const": "network-disabled-read-only-container"
        },
        "gold_visibility": {
          "const": "harness-only"
        },
        "workspace_validation_commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/argv"
          }
        },
        "online_evaluator_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "bundle", "hidden_evaluator"],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/relative_path"
        },
        "bundle": {
          "$ref": "#/$defs/relative_path"
        },
        "hidden_evaluator": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "workspace_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/relative_path"
      }
    },
    "initial_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed", "workspace_checks", "hidden_check"],
      "properties": {
        "expected": {
          "const": "fail"
        },
        "observed": {
          "enum": ["pass", "fail"]
        },
        "workspace_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check_result"
          }
        },
        "hidden_check": {
          "$ref": "#/$defs/check_result"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "exit_code", "duration_ms"],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": ["pass", "fail"]
        },
        "exit_code": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
