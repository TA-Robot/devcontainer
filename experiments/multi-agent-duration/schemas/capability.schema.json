{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcontainer.local/schemas/agent-duration-capability-v2.schema.json",
  "title": "Agent Duration Capability Probe v2",
  "description": "Content-free provider/runtime capability evidence; never a task-duration sample.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "observed_at",
    "probe",
    "model_identity",
    "model_inventory",
    "runtime_identity",
    "setting_surfaces",
    "setting_probes",
    "surfaces",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "capability_id": {
      "$ref": "#/$defs/id"
    },
    "observed_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "probe": {
      "$ref": "#/$defs/probe"
    },
    "model_identity": {
      "$ref": "#/$defs/model_identity"
    },
    "model_inventory": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/model_catalog_entry"
      }
    },
    "runtime_identity": {
      "$ref": "#/$defs/runtime_identity"
    },
    "setting_surfaces": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/setting_surface"
      }
    },
    "setting_probes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/setting_probe"
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progress_artifact", "synthesis_envelope", "permission_mode"],
      "properties": {
        "progress_artifact": {
          "enum": ["observed", "not-observed", "not-applicable", "unknown"]
        },
        "synthesis_envelope": {
          "enum": ["observed", "not-observed", "not-applicable", "unknown"]
        },
        "permission_mode": {
          "enum": ["automatic", "approval-gated", "unknown"]
        }
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "bounded_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "scalar": {
      "type": ["string", "number", "boolean"]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "generation_request_performed",
        "provider_metadata_request_attempted",
        "metadata_scope",
        "raw_output_persisted",
        "commands"
      ],
      "properties": {
        "mode": {
          "enum": ["passive-cli", "live-canary"]
        },
        "generation_request_performed": {
          "type": "boolean"
        },
        "provider_metadata_request_attempted": {
          "type": "boolean"
        },
        "metadata_scope": {
          "enum": ["provider-current", "bundled", "not-requested"]
        },
        "raw_output_persisted": {
          "const": false
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/probe_command"
          }
        }
      }
    },
    "probe_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "status", "evidence_source", "duration_ms"],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": ["observed", "unavailable", "failed", "timed-out"]
        },
        "evidence_source": {
          "enum": [
            "version-output",
            "root-help",
            "model-catalog-json",
            "model-list-text"
          ]
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_source", "identity_confidence"],
      "properties": {
        "requested_alias": {
          "$ref": "#/$defs/bounded_string"
        },
        "requested_source": {
          "enum": ["flag", "config-file", "runtime-default", "unknown"]
        },
        "resolved_id": {
          "$ref": "#/$defs/bounded_string"
        },
        "identity_confidence": {
          "enum": ["exact", "alias-only", "default-unspecified", "unknown"]
        },
        "snapshot_hint": {
          "$ref": "#/$defs/bounded_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_confidence": {
                "const": "exact"
              }
            },
            "required": ["identity_confidence"]
          },
          "then": {
            "required": ["resolved_id"]
          }
        },
        {
          "if": {
            "properties": {
              "identity_confidence": {
                "const": "alias-only"
              }
            },
            "required": ["identity_confidence"]
          },
          "then": {
            "required": ["requested_alias"]
          }
        }
      ]
    },
    "model_catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "catalog_status", "identity_confidence"],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/bounded_string"
        },
        "display_name": {
          "$ref": "#/$defs/bounded_string"
        },
        "catalog_status": {
          "enum": ["advertised-default", "available", "hidden", "unknown"]
        },
        "identity_confidence": {
          "enum": ["catalog-id-with-snapshot", "catalog-id", "alias-only"]
        },
        "snapshot_hint": {
          "$ref": "#/$defs/bounded_string"
        }
      }
    },
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "cli_name",
        "cli_version",
        "cli_source",
        "execution_surface",
        "environment_kind",
        "permission_mode",
        "observed_at"
      ],
      "properties": {
        "provider": {
          "enum": ["codex", "claude", "grok", "fixture"]
        },
        "cli_name": {
          "$ref": "#/$defs/bounded_string"
        },
        "cli_version": {
          "$ref": "#/$defs/bounded_string"
        },
        "cli_source": {
          "enum": ["container-image", "host-sync", "fixture", "unknown"]
        },
        "image_digest": {
          "$ref": "#/$defs/sha256"
        },
        "execution_surface": {
          "enum": [
            "capability-probe",
            "direct-provider",
            "agentctl-job",
            "legacy-comparator",
            "fixture"
          ]
        },
        "environment_kind": {
          "enum": ["host", "devcontainer", "fixture", "unknown"]
        },
        "permission_mode": {
          "enum": ["automatic", "approval-gated", "unknown"]
        },
        "observed_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "build_hint": {
          "$ref": "#/$defs/bounded_string"
        },
        "release_channel": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "setting_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "key",
        "advertisement",
        "evidence_source",
        "application_observability"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/id"
        },
        "key": {
          "$ref": "#/$defs/id"
        },
        "model_selector": {
          "$ref": "#/$defs/bounded_string"
        },
        "advertisement": {
          "enum": ["enumerated", "flag-only", "not-advertised", "unknown"]
        },
        "advertised_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        },
        "default_value": {
          "$ref": "#/$defs/scalar"
        },
        "evidence_source": {
          "enum": ["root-help", "model-catalog", "models-command", "live-canary", "unknown"]
        },
        "application_observability": {
          "enum": ["direct", "indirect", "not-observed", "unknown"]
        }
      }
    },
    "setting_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key", "requested_value", "status"],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/id"
        },
        "key": {
          "$ref": "#/$defs/id"
        },
        "requested_value": {
          "$ref": "#/$defs/scalar"
        },
        "status": {
          "enum": ["applied", "rejected", "not-advertised", "unknown"]
        },
        "applied_value": {
          "$ref": "#/$defs/scalar"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "applied"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["applied_value"]
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_inventory",
        "setting_advertisement",
        "setting_application",
        "runtime_identity",
        "limitations"
      ],
      "properties": {
        "model_inventory": {
          "enum": ["exact", "partial", "not-observed", "unknown"]
        },
        "setting_advertisement": {
          "enum": ["exact", "partial", "not-observed", "unknown"]
        },
        "setting_application": {
          "enum": ["exact", "partial", "not-observed", "unknown"]
        },
        "runtime_identity": {
          "enum": ["exact", "partial", "not-observed", "unknown"]
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
