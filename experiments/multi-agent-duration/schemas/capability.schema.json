{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcontainer.local/schemas/agent-duration-capability-v1.schema.json",
  "title": "Agent Duration Capability Probe v1",
  "description": "Provider/runtime identity and settings probe; never a task-duration sample.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "observed_at",
    "model_identity",
    "runtime_identity",
    "setting_probes",
    "surfaces"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "capability_id": {
      "$ref": "#/$defs/id"
    },
    "observed_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "model_identity": {
      "$ref": "#/$defs/model_identity"
    },
    "runtime_identity": {
      "$ref": "#/$defs/runtime_identity"
    },
    "setting_probes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/setting_probe"
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progress_artifact", "synthesis_envelope", "permission_mode"],
      "properties": {
        "progress_artifact": {
          "enum": ["observed", "not-observed", "not-applicable", "unknown"]
        },
        "synthesis_envelope": {
          "enum": ["observed", "not-observed", "not-applicable", "unknown"]
        },
        "permission_mode": {
          "enum": ["automatic", "approval-gated", "unknown"]
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "scalar": {
      "type": ["string", "number", "boolean"]
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_source", "identity_confidence"],
      "properties": {
        "requested_alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requested_source": {
          "enum": ["flag", "config-file", "runtime-default", "unknown"]
        },
        "resolved_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identity_confidence": {
          "enum": ["exact", "alias-only", "default-unspecified", "unknown"]
        },
        "snapshot_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_confidence": {
                "const": "exact"
              }
            },
            "required": ["identity_confidence"]
          },
          "then": {
            "required": ["resolved_id"]
          }
        },
        {
          "if": {
            "properties": {
              "identity_confidence": {
                "const": "alias-only"
              }
            },
            "required": ["identity_confidence"]
          },
          "then": {
            "required": ["requested_alias"]
          }
        }
      ]
    },
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "cli_name",
        "cli_version",
        "cli_source",
        "execution_surface",
        "permission_mode",
        "observed_at"
      ],
      "properties": {
        "provider": {
          "enum": ["codex", "claude", "grok", "fixture"]
        },
        "cli_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cli_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cli_source": {
          "enum": ["container-image", "host-sync", "fixture", "unknown"]
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution_surface": {
          "enum": ["direct-provider", "agentctl-job", "legacy-comparator", "fixture"]
        },
        "permission_mode": {
          "enum": ["automatic", "approval-gated", "unknown"]
        },
        "observed_at": {
          "$ref": "#/$defs/utc_timestamp"
        }
      }
    },
    "setting_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key", "requested_value", "status"],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/id"
        },
        "key": {
          "$ref": "#/$defs/id"
        },
        "requested_value": {
          "$ref": "#/$defs/scalar"
        },
        "status": {
          "enum": ["applied", "rejected", "not-advertised", "unknown"]
        },
        "applied_value": {
          "$ref": "#/$defs/scalar"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "applied"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["applied_value"]
          }
        }
      ]
    }
  }
}
