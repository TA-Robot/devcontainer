{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcontainer.local/schemas/agent-duration-validity-v1.schema.json",
  "title": "Agent Duration Effort-Inference Validity v1",
  "description": "Revision-aware audit of whether a case design and one observation may support effort-versus-quality inference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validity_id",
    "catalog",
    "audited_at",
    "scope",
    "policy",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "validity_id": {"$ref": "#/$defs/id"},
    "catalog": {"$ref": "#/$defs/catalog_ref"},
    "audited_at": {"$ref": "#/$defs/utc_timestamp"},
    "scope": {"const": "same-case-effort-quality-inference"},
    "policy": {"$ref": "#/$defs/policy"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "catalog_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "revision", "digest"],
      "properties": {
        "catalog_id": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_design_gates", "observation_gates", "comparison_gates"],
      "properties": {
        "case_design_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "observation_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "comparison_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_revision",
        "design_status",
        "inference_use",
        "task_contract_visibility",
        "oracle_alignment",
        "solution_space_calibration",
        "artifact_retention_requirement",
        "reason_codes",
        "evidence_paths"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "case_revision": {"type": "integer", "minimum": 1},
        "design_status": {
          "enum": ["eligible", "conditional", "ineligible"]
        },
        "inference_use": {
          "enum": ["eligible-after-observation-gates", "conditional-only", "excluded"]
        },
        "task_contract_visibility": {
          "enum": ["complete", "partial", "incomplete"]
        },
        "oracle_alignment": {
          "enum": ["semantic", "contract-bound", "lexical-proxy", "overfit", "unknown"]
        },
        "solution_space_calibration": {
          "enum": ["plural-gold", "single-gold", "not-required", "unverified"]
        },
        "artifact_retention_requirement": {
          "enum": ["required-for-fail-adjudication", "required-for-all-quality", "optional"]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
