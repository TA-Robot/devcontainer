{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcontainer.local/schemas/agent-duration-case-catalog-v1.schema.json",
  "title": "Agent Duration Case Catalog v1",
  "description": "Versioned structural cases and disposable fixture execution contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "revision", "published_at", "entries"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "published_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "bounded_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "fixture"],
      "properties": {
        "case": {
          "type": "object"
        },
        "fixture": {
          "$ref": "#/$defs/fixture"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "recipe_id",
        "recipe_revision",
        "capsule_path",
        "lane",
        "task_network_policy",
        "isolation_required",
        "evaluator_isolation_required",
        "workspace_validation_commands",
        "hidden_validation_targets",
        "online_evaluator_id",
        "gold_visibility"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "recipe_id": {
          "$ref": "#/$defs/id"
        },
        "recipe_revision": {
          "type": "integer",
          "minimum": 1
        },
        "capsule_path": {
          "$ref": "#/$defs/bounded_string"
        },
        "lane": {
          "const": "isolated"
        },
        "task_network_policy": {
          "const": "disabled"
        },
        "isolation_required": {
          "const": "workspace-only-container-mount"
        },
        "evaluator_isolation_required": {
          "const": "network-disabled-read-only-container"
        },
        "workspace_validation_commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/argv"
          }
        },
        "hidden_validation_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/hidden_validation_target"
          }
        },
        "online_evaluator_id": {
          "$ref": "#/$defs/id"
        },
        "gold_visibility": {
          "const": "harness-only"
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "hidden_validation_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "test_target"],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "test_target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        }
      }
    }
  }
}
