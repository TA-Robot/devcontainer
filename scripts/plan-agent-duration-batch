#!/usr/bin/env python3
"""Write one deterministic provider-free finite C0 duration batch."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from agent_contracts import ContractValidationError
from agent_duration_batch_plan import DEFAULT_CATALOG, Series, plan_batch_from_catalog
from agent_duration_study import DurationStudyError, atomic_write_json


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--catalog", type=Path, default=DEFAULT_CATALOG)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--batch-id", required=True)
    parser.add_argument("--study-id", required=True)
    parser.add_argument("--block-id", required=True)
    parser.add_argument(
        "--provider",
        action="append",
        required=True,
        choices=("codex", "claude", "grok"),
        help="provider for one explicit series row; align repeat occurrences with --model/--effort",
    )
    parser.add_argument(
        "--model",
        action="append",
        required=True,
        help="requested model for one explicit series row; no model is inferred",
    )
    parser.add_argument(
        "--effort",
        action="append",
        required=True,
        help="requested effort for one explicit series row; provider support is preflighted",
    )
    parser.add_argument("--case-id", action="append", default=[])
    parser.add_argument("--family", action="append", default=[])
    parser.add_argument("--size", action="append", default=[], choices=("S", "M", "L"))
    parser.add_argument("--rotation-seed", type=int, required=True)
    parser.add_argument("--repeat", type=int, required=True)
    parser.add_argument("--max-runs", type=int, required=True)
    parser.add_argument("--deadline-seconds", type=float, required=True)
    parser.add_argument("--timeout-seconds", type=float, required=True)
    parser.add_argument("--evaluator-timeout-seconds", type=float, required=True)
    parser.add_argument("--output-bytes-cap", type=int, required=True)
    parser.add_argument(
        "--artifact-retention",
        choices=("content-free-only", "task-artifacts"),
        default="task-artifacts",
        help="retain only bounded allowlisted synthetic task artifacts by default",
    )
    parser.add_argument(
        "--created-at",
        help="UTC batch timestamp; defaults deterministically to the catalog publication timestamp",
    )
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    row_counts = (len(args.provider), len(args.model), len(args.effort))
    if len(set(row_counts)) != 1:
        parser.error(
            "repeat --provider, --model, and --effort equally; occurrences form zipped series rows"
        )
    explicit_series = [
        Series(provider=provider, model=model, effort=effort)
        for provider, model, effort in zip(args.provider, args.model, args.effort, strict=True)
    ]
    try:
        manifest = plan_batch_from_catalog(
            args.catalog.resolve(),
            batch_id=args.batch_id,
            study_id=args.study_id,
            block_id=args.block_id,
            series=explicit_series,
            case_ids=args.case_id,
            families=args.family,
            sizes=args.size,
            rotation_seed=args.rotation_seed,
            repeat=args.repeat,
            max_runs=args.max_runs,
            deadline_seconds=args.deadline_seconds,
            timeout_seconds=args.timeout_seconds,
            evaluator_timeout_seconds=args.evaluator_timeout_seconds,
            output_bytes_cap=args.output_bytes_cap,
            artifact_retention=args.artifact_retention,
            created_at=args.created_at,
        )
        output = args.output.resolve()
        atomic_write_json(output, manifest)
    except (ContractValidationError, DurationStudyError, OSError) as exc:
        parser.exit(2, f"error: {exc}\n")
    print(
        json.dumps(
            {
                "batch_id": manifest["batch_id"],
                "catalog_digest": manifest["catalog_digest"],
                "entries": len(manifest["entries"]),
                "output": str(output),
                "provider_calls": 0,
            },
            ensure_ascii=False,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
