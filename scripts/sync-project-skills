#!/usr/bin/env python3
"""Mirror canonical `.agents/skills` into provider skill directories.

Codex and Grok Build read `.agents/skills`; Claude Code reads `.claude/skills`.
The mirror omits each skill's Codex-only `agents/` metadata directory.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from agent_contracts import SKILL_MIRRORS, expected_skill_mirror, skill_mirror_differences  # noqa: E402


def sync(root: Path) -> list[str]:
    expected = expected_skill_mirror(root)
    changed: list[str] = []
    for mirror in SKILL_MIRRORS:
        base = root / mirror
        for relative, (data, executable) in expected.items():
            target = base / relative
            mode = 0o755 if executable else 0o644
            if target.is_file() and target.read_bytes() == data and bool(target.stat().st_mode & 0o111) == executable:
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
            os.chmod(target, mode)
            changed.append(f"{mirror}/{relative}")
        if base.is_dir():
            for path in sorted(base.rglob("*"), reverse=True):
                relative = path.relative_to(base).as_posix()
                if path.is_file() and relative not in expected and "__pycache__" not in path.parts:
                    path.unlink()
                    changed.append(f"{mirror}/{relative} (removed)")
                elif path.is_dir() and not any(path.iterdir()):
                    path.rmdir()
    return changed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--template-root", type=Path, default=Path(__file__).resolve().parent.parent / "project")
    parser.add_argument("--check", action="store_true", help="report differences without writing")
    args = parser.parse_args()
    root = args.template_root
    if args.check:
        differences = skill_mirror_differences(root)
        for line in differences:
            print(line, file=sys.stderr)
        if differences:
            print("skill mirrors are stale; run scripts/sync-project-skills", file=sys.stderr)
            return 1
        print("ok - skill mirrors match .agents/skills")
        return 0
    for line in sync(root):
        print(line)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
