#!/usr/bin/env python3
"""Build or check the complete duration-atlas catalog."""

from __future__ import annotations

import argparse
import json

from agent_contracts import load_json
from agent_duration_catalog import AGGREGATE_PATH, compose_catalog, replace_catalog
from agent_duration_study import DurationStudyError


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--revision", type=int, required=True)
    parser.add_argument("--published-at", required=True)
    parser.add_argument("--write", action="store_true")
    args = parser.parse_args()
    if args.revision < 1:
        parser.error("--revision must be positive")
    try:
        catalog = compose_catalog(revision=args.revision, published_at=args.published_at)
        if args.write:
            replace_catalog(AGGREGATE_PATH, catalog)
        elif AGGREGATE_PATH.exists() and load_json(AGGREGATE_PATH) != catalog:
            raise DurationStudyError("aggregate duration catalog is stale; rerun with --write")
    except DurationStudyError as exc:
        parser.exit(2, f"error: {exc}\n")
    print(
        json.dumps(
            {
                "catalog": str(AGGREGATE_PATH),
                "revision": catalog["revision"],
                "cases": len(catalog["entries"]),
                "written": args.write,
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
