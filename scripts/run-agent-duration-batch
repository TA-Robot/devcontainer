#!/usr/bin/env python3
"""Dry-run or execute one explicit finite duration-study batch."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from agent_duration_batch import execute_batch, load_and_validate_batch
from agent_duration_study import DurationStudyError


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("batch", type=Path)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--image", required=True)
    parser.add_argument("--docker-bin", default="docker")
    parser.add_argument("--codex-auth", type=Path, default=Path.home() / ".codex" / "auth.json")
    parser.add_argument(
        "--claude-auth",
        type=Path,
        default=Path.home() / ".claude" / ".credentials.json",
    )
    parser.add_argument("--grok-auth", type=Path, default=Path.home() / ".grok" / "auth.json")
    parser.add_argument("--grok-binary", type=Path)
    parser.add_argument("--execute", action="store_true")
    parser.add_argument("--confirm-live-provider", action="store_true")
    args = parser.parse_args()
    try:
        batch = load_and_validate_batch(args.batch.resolve())
        result = execute_batch(
            batch,
            output_dir=args.output_dir,
            image=args.image,
            auth_files={
                "codex": args.codex_auth,
                "claude": args.claude_auth,
                "grok": args.grok_auth,
            },
            live_generation_authorized=args.confirm_live_provider,
            execute=args.execute,
            docker_bin=args.docker_bin,
            grok_binary=args.grok_binary,
        )
    except (DurationStudyError, OSError) as exc:
        parser.exit(2, f"error: {exc}\n")
    print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    return 0 if result["stop_reason"] in {"completed", "dry-run"} else 1


if __name__ == "__main__":
    raise SystemExit(main())
