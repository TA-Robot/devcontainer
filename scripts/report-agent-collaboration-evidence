#!/usr/bin/env python3
"""Report bounded project-local evidence from Mira collaboration episodes."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import sys

from collaboration_evidence import (
    DEFAULT_MAX_OUTPUT_BYTES,
    EvidenceReportError,
    bounded_output,
    build_report,
    load_ledger,
    render_markdown,
)


def default_ledger() -> Path:
    configured = os.environ.get("MIRA_COMPANION_EPISODE_DIR")
    if configured:
        return Path(configured).expanduser() / "collaboration-episodes.json"
    return Path("/var/lib/mira-observations/collaboration-episodes.json")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ledger", type=Path, default=default_ledger())
    parser.add_argument("--format", choices=("json", "markdown"), default="json")
    parser.add_argument("--workspace", help="Optional opaque workspace key; never emitted in the report")
    parser.add_argument("--max-episodes", type=int, default=512)
    parser.add_argument("--max-groups", type=int, default=100)
    parser.add_argument("--min-group-size", type=int, default=1)
    parser.add_argument("--max-output-bytes", type=int, default=DEFAULT_MAX_OUTPUT_BYTES)
    args = parser.parse_args()
    try:
        report = build_report(
            load_ledger(args.ledger),
            max_episodes=args.max_episodes,
            max_groups=args.max_groups,
            min_group_size=args.min_group_size,
            workspace=args.workspace,
        )
        rendered = (
            json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
            if args.format == "json"
            else render_markdown(report)
        )
        sys.stdout.write(bounded_output(rendered, args.max_output_bytes))
    except EvidenceReportError as exc:
        print(f"collaboration evidence report failed: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
