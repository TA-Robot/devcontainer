{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcontainer.local/schemas/collaboration-decision-v1.schema.json",
  "title": "Collaboration Decision Packet v1",
  "description": "Project-local, pre-execution record of why a solo or multi-agent topology was selected. This packet is not activity telemetry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "base_sha",
    "task_fingerprint",
    "candidates",
    "selected_candidate_id",
    "decision",
    "limits",
    "unknowns"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"$ref": "#/$defs/local_id"},
    "project_id": {"$ref": "#/$defs/local_id"},
    "base_sha": {"$ref": "#/$defs/git_sha"},
    "task_fingerprint": {"$ref": "#/$defs/task_fingerprint"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "selected_candidate_id": {"$ref": "#/$defs/local_id"},
    "decision": {"$ref": "#/$defs/decision"},
    "limits": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/limit"}
    },
    "unknowns": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/note"}
    }
  },
  "$defs": {
    "local_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "note": {"type": "string", "minLength": 1, "maxLength": 2048},
    "level": {"enum": ["low", "partial", "high", "unknown"]},
    "relation": {"enum": ["solo", "delegate", "consult", "compete", "verify", "project-specific"]},
    "lifecycle": {"enum": ["one-shot", "bounded-exchange", "event-triggered", "scheduled", "project-specific"]},
    "mechanism": {
      "enum": [
        "latency-overlap", "context-partitioning", "coverage", "error-decorrelation",
        "empirical-selection", "evidence-producing-refinement", "temporal-sampling", "project-specific"
      ]
    },
    "constraint": {
      "enum": [
        "serialization", "human-review", "wall-clock", "quota", "agentctl-capacity",
        "integration", "context-coupling", "evaluator", "late-failure", "other", "unknown"
      ]
    },
    "task_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "structural_size", "decomposability", "context_coupling", "oracle_strength", "risk", "temporal_shape"],
      "properties": {
        "family": {"$ref": "#/$defs/local_id"},
        "structural_size": {"enum": ["small", "medium", "large", "unknown"]},
        "decomposability": {"$ref": "#/$defs/level"},
        "context_coupling": {"$ref": "#/$defs/level"},
        "oracle_strength": {"enum": ["weak", "partial", "strong", "unknown"]},
        "risk": {"enum": ["reversible", "bounded", "high-impact", "unknown"]},
        "temporal_shape": {"enum": ["one-shot", "event-driven", "external-drift", "unknown"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "relation", "lifecycle", "expected_mechanisms", "binding_constraint",
        "participant_basis", "independence_policy", "lane", "permission_profile", "prediction", "stop_conditions"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/local_id"},
        "relation": {"$ref": "#/$defs/relation"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "expected_mechanisms": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "#/$defs/mechanism"}
        },
        "binding_constraint": {"$ref": "#/$defs/constraint"},
        "participant_basis": {"$ref": "#/$defs/note"},
        "independence_policy": {"$ref": "#/$defs/note"},
        "lane": {"enum": ["read", "write", "isolated", "mixed"]},
        "permission_profile": {"enum": ["safe", "trusted-fast", "isolated-autonomous", "mixed"]},
        "prediction": {"$ref": "#/$defs/prediction"},
        "stop_conditions": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"$ref": "#/$defs/note"}
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time", "quality", "coordination_cost", "evidence_basis"],
      "properties": {
        "wall_time": {"enum": ["lower", "similar", "higher", "unknown"]},
        "quality": {"enum": ["lower", "similar", "higher", "unknown"]},
        "coordination_cost": {"enum": ["low", "medium", "high", "unknown"]},
        "evidence_basis": {"enum": ["project-measured", "atlas-transfer", "mechanistic-prior", "none"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "rationale", "decisive_evidence", "external_side_effect_owner"],
      "properties": {
        "confidence": {"enum": ["low", "medium", "high", "unknown"]},
        "rationale": {"$ref": "#/$defs/note"},
        "decisive_evidence": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/note"}},
        "external_side_effect_owner": {"enum": ["primary", "human", "none"]}
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "role", "scope", "invalidation_evidence", "update_owner"],
      "properties": {
        "name": {"$ref": "#/$defs/local_id"},
        "value": {"$ref": "#/$defs/note"},
        "role": {"enum": ["hard-guard", "cost-cap", "planning-prior", "hypothesis"]},
        "scope": {"enum": ["candidate", "plan", "project"]},
        "invalidation_evidence": {"$ref": "#/$defs/note"},
        "update_owner": {"enum": ["primary", "broker", "human"]}
      }
    }
  }
}
