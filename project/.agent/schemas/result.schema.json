{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcontainer.local/schemas/agent-result-v1.schema.json",
  "title": "Agent Result Envelope v1",
  "description": "Provider-neutral final result for one agent job attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "status",
    "summary",
    "head_sha",
    "changed_paths",
    "dirty_state",
    "checks",
    "risks",
    "followups"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "$ref": "#/$defs/job_id"
    },
    "status": {
      "enum": ["ready_for_commit", "completed", "failed", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "head_sha": {
      "oneOf": [
        {
          "$ref": "#/$defs/git_sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/project_path"
      }
    },
    "dirty_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_dirty", "paths"],
      "properties": {
        "is_dirty": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/project_path"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "is_dirty": {
                "const": false
              }
            },
            "required": ["is_dirty"]
          },
          "then": {
            "properties": {
              "paths": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "is_dirty": {
                "const": true
              }
            },
            "required": ["is_dirty"]
          },
          "then": {
            "properties": {
              "paths": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "checks": {
      "description": "Commands actually executed by the worker. Manual acceptance evidence belongs in summary, risks, or followups; a passed command check requires exit_code 0.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "risks": {
      "$ref": "#/$defs/notes"
    },
    "followups": {
      "$ref": "#/$defs/notes"
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/project_path"
      }
    },
    "blocked_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "enum": ["provider", "process", "validation", "workspace", "unknown"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready_for_commit"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "head_sha": {
            "$ref": "#/$defs/git_sha"
          },
          "changed_paths": {
            "minItems": 1
          },
          "dirty_state": {
            "properties": {
              "is_dirty": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "head_sha": {
            "$ref": "#/$defs/git_sha"
          },
          "dirty_state": {
            "properties": {
              "is_dirty": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["blocked_reason"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["error"]
      }
    }
  ],
  "$defs": {
    "job_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "project_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+)$"
    },
    "notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "check": {
      "type": "object",
      "description": "One actually executed command and its observed process exit status.",
      "additionalProperties": false,
      "required": ["command", "status", "exit_code", "summary"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "status": {
          "enum": ["passed", "failed", "skipped"]
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
