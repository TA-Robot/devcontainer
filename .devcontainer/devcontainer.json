{
  "name": "Cursor Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Trusted local development profile: privileged container + direct host credential mounts.
  // This configuration optimizes for convenience, not sandbox isolation.
  
  // コンテナ設定
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  
  // ユーザー設定
  "remoteUser": "devuser",

  // bind mount 元を用意し、ホストにある AI CLI のバージョン番号を記録する。
  // 実行ファイル自体は OS/CPU が異なり得るため mount せず、postStartCommand で
  // コンテナ向けの同一 npm version を導入する。
  "initializeCommand": "sh \"${localWorkspaceFolder}/.devcontainer/initialize-host.sh\"",
  
  // 機能追加（必要に応じてコメントアウト解除）
  "features": {
    // Docker-in-Docker サポート
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // Git設定
    "ghcr.io/devcontainers/features/git:1": {},
    // GitHub CLI
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  
  // 拡張機能（Cursorで使いたい拡張機能を追加）
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "github.copilot"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true
      }
    }
  },
  
  // マウント設定（ホストの設定を引き継ぐ）
  "mounts": [
    // ホストのSSH鍵を共有（Git操作用）
    "source=${localEnv:HOME}/.ssh,target=/home/devuser/.ssh,type=bind,readonly",
    // ホストのGit設定を共有
    "source=${localEnv:HOME}/.gitconfig,target=/home/devuser/.gitconfig,type=bind,readonly",
    // AI CLI認証情報はホスト側ディレクトリ/ファイルを直接参照する（token更新も相互に反映される）
    "source=${localEnv:HOME}/.codex,target=/home/devuser/.codex,type=bind",
    "source=${localEnv:HOME}/.config/gemini,target=/home/devuser/.config/gemini,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/devuser/.claude.json,type=bind",
    "source=${localEnv:HOME}/.claude,target=/home/devuser/.claude,type=bind",
    // initializeCommand が生成したバージョン番号だけを共有する（credential は含まない）
    "source=${localEnv:HOME}/.cache/devcontainer-ai-cli,target=/opt/devcontainer-host-ai-cli,type=bind,readonly"
  ],
  
  // 環境変数
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    // 0 にするとホスト AI CLI バージョン同期を無効化できる
    "DEVCONTAINER_AI_CLI_SYNC": "${localEnv:DEVCONTAINER_AI_CLI_SYNC}",
    // APIキー（ホストに設定されていれば引き継ぐ）
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "SAKANA_API_KEY": "${localEnv:SAKANA_API_KEY}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  
  "postCreateCommand": "echo '✅ Dev Container is ready!' && git --version && node --version 2>/dev/null || true",
  "postStartCommand": "bash /workspace/scripts/sync-host-ai-cli-versions",
  
  // 追加のrunArgs（必要に応じて調整）
  "runArgs": [
    "--init",
    "--privileged"
  ],
  
  // セキュリティオプション
  "securityOpt": [
    "seccomp=unconfined"
  ]
}
