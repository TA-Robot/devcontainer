{
  "name": "Cursor Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Trusted local development profile: privileged container + read-only host credential snapshots.
  // This configuration optimizes for convenience, not sandbox isolation.
  
  // コンテナ設定
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  
  // ユーザー設定
  "remoteUser": "devuser",
  
  // 機能追加（必要に応じてコメントアウト解除）
  "features": {
    // Docker-in-Docker サポート
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // Git設定
    "ghcr.io/devcontainers/features/git:1": {},
    // GitHub CLI
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  
  // 拡張機能（Cursorで使いたい拡張機能を追加）
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "github.copilot"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true
      }
    }
  },
  
  // マウント設定（ホストの設定を引き継ぐ）
  "mounts": [
    // ホストのSSH鍵を共有（Git操作用）
    "source=${localEnv:HOME}/.ssh,target=/home/devuser/.ssh,type=bind,readonly",
    // ホストのGit設定を共有
    "source=${localEnv:HOME}/.gitconfig,target=/home/devuser/.gitconfig,type=bind,readonly",
    // Codex認証情報を read-only で取り込み、container local に同期する
    "source=${localEnv:HOME}/.codex,target=/mnt/host-auth/codex,type=bind,readonly",
    // Gemini CLI設定を read-only で取り込み、container local に同期する
    "source=${localEnv:HOME}/.config/gemini,target=/mnt/host-auth/gemini,type=bind,readonly"
  ],
  
  // 環境変数
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    // APIキー（ホストに設定されていれば引き継ぐ）
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}"
  },
  
  // コンテナ作成/起動後に host auth snapshot を container local へ反映する
  "postCreateCommand": "devcontainer-sync-host-auth && echo '✅ Dev Container is ready!' && git --version && node --version 2>/dev/null || true",
  "postStartCommand": "devcontainer-sync-host-auth",
  
  // 追加のrunArgs（必要に応じて調整）
  "runArgs": [
    "--init",
    "--privileged"
  ],
  
  // セキュリティオプション
  "securityOpt": [
    "seccomp=unconfined"
  ]
}
